from tabulate import tabulate

words = ["connected", "connecting", "connection"]

results = []

for word in words:

    if word.endswith("ed"):
        root = word[:-2]
        suffix = "ed"
        transformation = "Inflectional"

    elif word.endswith("ing"):
        root = word[:-3]
        suffix = "ing"
        transformation = "Inflectional"

    elif word.endswith("ion"):
        root = word[:-3]
        suffix = "ion"
        transformation = "Derivational"

    else:
        root = word
        suffix = "-"
        transformation = "None"

    # Normalize root
    if root == "connect":
        normalized = "connect"
    else:
        normalized = root

    parsed = root + " + " + suffix

    results.append([word, parsed, suffix, transformation, normalized])

print(tabulate(
    results,
    headers=[
        "Original Word",
        "Parsed Structure",
        "Suffix",
        "Transformation",
        "Normalized Root"
    ],
    tablefmt="grid"
))
