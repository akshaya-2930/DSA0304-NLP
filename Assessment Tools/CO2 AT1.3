from tabulate import tabulate
from nltk.stem import PorterStemmer

ps = PorterStemmer()

words = ["played", "player", "playing"]

results = []

for word in words:
    stem = ps.stem(word)

    if word.endswith("ed"):
        affix = "ed"
        transform = "Inflectional"
    elif word.endswith("ing"):
        affix = "ing"
        transform = "Inflectional"
    elif word.endswith("er"):
        affix = "er"
        transform = "Derivational"
    else:
        affix = "-"
        transform = "None"

    results.append([word, stem, affix, transform, stem])

print(tabulate(results,
headers=["Original Word","Stem","Removed Affix","Transformation","Normalized Form"],
tablefmt="grid"))
