from tabulate import tabulate

words = ["writes", "writing", "written"]

results = []

for word in words:

    if word == "writes":
        root = "write"
        suffix = "s"
        pattern = "Regular"
        path = "q0 → q1 → q2"

    elif word == "writing":
        root = "write"
        suffix = "ing"
        pattern = "Regular"
        path = "q0 → q1 → q3"

    elif word == "written":
        root = "write"
        suffix = "en"
        pattern = "Irregular"
        path = "q0 → q4"

    results.append([
        word,
        path,
        root,
        suffix,
        pattern,
        root
    ])

print(tabulate(
    results,
    headers=[
        "Word",
        "State Transition",
        "Root",
        "Suffix",
        "Pattern",
        "Normalized Form"
    ],
    tablefmt="grid"
))
