# DFA Simulator
# Language: Strings ending with "ab"

states = {"q0", "q1", "q2"}
alphabet = {"a", "b"}

# Transition Table
transitions = {
    ("q0", "a"): "q1",
    ("q0", "b"): "q0",
    ("q1", "a"): "q1",
    ("q1", "b"): "q2",
    ("q2", "a"): "q1",
    ("q2", "b"): "q0"
}

initial_state = "q0"
final_states = {"q2"}

# Direct input strings
input_strings = ["abaab", "aab", "abba", "ab"]

for string in input_strings:
    current_state = initial_state
    path = [current_state]

    valid = True

    for symbol in string:
        if symbol not in alphabet:
            valid = False
            break

        current_state = transitions[(current_state, symbol)]
        path.append(current_state)

    print("\nInput String:", string)
    print("Transition Path:", " -> ".join(path))

    if valid and current_state in final_states:
        print("Accepted")
    else:
        print("Rejected")
