from nltk.stem import PorterStemmer

ps = PorterStemmer()

words = [
    "watches",
    "watching",
    "washable",
    "washer",
    "washed"
]

for word in words:
    print(word, "->", ps.stem(word))

print("\nInflectional: watches, watching, washed")
print("Derivational: washable, washer")
print("Lemmatization is a better strategy for preserving meaning.")
