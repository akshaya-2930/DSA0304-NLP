queries = {
    "Q1": ("Activate Roaming", "Activate Roaming"),
    "Q2": ("Deactivate Caller Tune", "Activate Caller Tune"),
    "Q3": ("Check Data Balance", "Query Data Balance"),
    "Q4": ("Enable 5G Service", "Activate 5G Service")
}

